<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Integration\**" />
    <Compile Include="Integration/Gameplay/HealingNeedlesWeapon.cs" Link="Services/HealingNeedlesWeapon.cs" />
    <Content Remove="Integration\**" />
    <None Remove="Integration\**" />
    <ProjectReference Include="Integration\Contracts\AbilityDraft.Contracts.csproj" />
    <ProjectReference Include="Integration\MatchHosting\AbilityDraft.MatchHosting.csproj" />
    <Compile Remove="Tools\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Integration\dist\ability_draft_base.vpk" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Integration\dist\ability_draft_base.vpk')" />
  </ItemGroup>

  <!-- Prepare before content discovery for both dotnet run/build and publish.
       These files do not exist when a fresh checkout is first evaluated. -->
  <Target Name="PrepareGameplayExportAssets" BeforeTargets="AssignTargetPaths">
    <Exec Condition="'$(DesignTimeBuild)' != 'true'" Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/Integration/ExportAssets/AbilityDraft.ExportAssets.csproj&quot; --configuration &quot;$(Configuration)&quot; -- &quot;$(MSBuildProjectDirectory)&quot; &quot;$(Configuration)&quot;" />
    <ItemGroup>
      <Content Include="$(MSBuildProjectDirectory)/Integration/dist/gameplay/AbilityDraft.Gameplay.dll" Condition="Exists('$(MSBuildProjectDirectory)/Integration/dist/gameplay/AbilityDraft.Gameplay.dll')">
        <Link>Integration/dist/gameplay/AbilityDraft.Gameplay.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
      <_GameplayExportLocalisation Include="$(MSBuildProjectDirectory)/Integration/dist/localization/**/*.txt" />
      <Content Include="@(_GameplayExportLocalisation)">
        <Link>Integration/dist/localization/%(_GameplayExportLocalisation.RecursiveDir)%(_GameplayExportLocalisation.Filename)%(_GameplayExportLocalisation.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </Content>
    </ItemGroup>
  </Target>

</Project>
