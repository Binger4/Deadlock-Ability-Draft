<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Integration\**" />
    <Content Remove="Integration\**" />
    <None Remove="Integration\**" />
    <ProjectReference Include="Integration\Contracts\AbilityDraft.Contracts.csproj" />
    <ProjectReference Include="Integration\MatchHosting\AbilityDraft.MatchHosting.csproj" />
    <Compile Remove="Tools\**" />
    <Content Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Integration\dist\ability_draft_base.vpk" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Integration\dist\ability_draft_base.vpk')" />
    <Content Include="Integration\dist\gameplay\AbilityDraft.Gameplay.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Integration\dist\gameplay\AbilityDraft.Gameplay.dll')" />
    <Content Include="Integration\dist\localization\**\*.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
