<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <DeadworksManagedDir Condition="'$(DeadworksManagedDir)' == ''">../../Tools/DeadworksRelease/v0.6.1/game/bin/win64/managed</DeadworksManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Gameplay/NativeDennyCompatibility.cs" Link="NativeDennyCompatibility.cs" />
    <Compile Include="../Gameplay/DraftedAlternateFire.cs" Link="DraftedAlternateFire.cs" />
    <Compile Include="../Gameplay/CompatibilityResources.cs" Link="CompatibilityResources.cs" />
    <EmbeddedResource Include="../Gameplay/compatibility-resources.json" LogicalName="AbilityDraft.Gameplay.compatibility-resources.json" />
    <ProjectReference Include="../Runtime/AbilityDraft.Runtime.csproj" />
    <Reference Include="DeadworksManaged.Api"><HintPath>$(DeadworksManagedDir)/DeadworksManaged.Api.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Google.Protobuf"><HintPath>$(DeadworksManagedDir)/Google.Protobuf.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireSdk" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(DeadworksManagedDir)/DeadworksManaged.Api.dll')" Text="Set DeadworksManagedDir to the installed Deadworks 0.6.1 managed directory. See Integration/HOSTING.md." />
  </Target>
</Project>
